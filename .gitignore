# macOS
.DS_Store
.AppleDouble
.LSOverride

# FUSE mount artifacts — orphaned copies of files replaced while a process
# still held them open; safe to delete
.fuse_hidden*

# Node
node_modules/

# Build artifacts — compiled CSS is committed, source maps are not
*.css.map

# Fantasticon intermediate output — the real output is assets/scss/icons/_icon-font.scss
assets/fonts/icon-font.css

# Claude Code: keep local state private; share scoped rules and skills
.claude/*
!.claude/rules/
!.claude/rules/**
!.claude/skills/
!.claude/skills/**

# Local working docs (plans, proposals, issue drafts, mirrored ProductBoard notes) — not shipped
notes/

# API tokens — the shell environment is where they belong; this catches a stray file
.env
.env.*
